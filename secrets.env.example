# Real contact details injected into the CV at build time.
# Copy this file to secrets.env and fill in your values. secrets.env is gitignored.
# -r fr uses the FR values; -r be uses the BE values (and shows the Belgian city).
LOCATION_FR="Your City, Country"
PHONE_FR="+00 000 00 00 00"
LOCATION_BE="Your City, Belgium"
PHONE_BE="+32 000 00 00 00"
EMAIL="you@example.com"
